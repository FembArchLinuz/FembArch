#!/usr/bin/env bash

set -e

echo ""
echo "[INFO]: You may run this script when you are ready. And also wait 5 seconds."
echo "[fembinstall] This script handles partitoning, pacstrapping system, genfstabing, chrooting, making the password and user with bootloader."

sleep 5


wifi_connection() {
   bash /usr/local/bin/fembinstall-files/wifi-connection/wifi.sh
}

partitioning_mounting() {
umount -R /mnt 2>/dev/null || true
mkdir -p /mnt /mnt/boot /mnt/boot/efi

# EFI (UEFI) Check.
if [[ ! -d /sys/firmware/efi ]]; then
    echo "[ERROR]: UEFI mode required. BIOS not supported."
    exit 1
fi

read -p "Select disk: " DISK

parted -s "$DISK" mklabel gpt
parted -s "$DISK" mkpart ESP fat32 1MiB 513MiB
parted -s "$DISK" set 1 esp on
parted -s "$DISK" mkpart root ext4 513MiB 100%

partprobe "$DISK"
sleep 1

BOOT_PART=$(lsblk -lnpo NAME,PARTTYPE "$DISK" | awk '$2 ~ /c12a7328-f81f-11d2-ba4b-00a0c93ec93b/ {print $1}')
ROOT_PART=$(lsblk -lnpo NAME "$DISK" | awk 'NR==3 {print $1}')

mkfs.fat -F32 "$BOOT_PART"
mkfs.ext4 "$ROOT_PART"

mount "$ROOT_PART" /mnt
mount "$BOOT_PART" /mnt/boot/efi
}


pacstrapping_sys() {
    echo "[INFO]: Pacstrapping system..."
    sleep 0.5
    pacstrap /mnt nano vim fastfetch hyprland xdg-desktop-portal-hyprland sddm kitty base base-devel linux linux-firmware arch-install-scripts linux-headers grub efibootmgr networkmanager waybar wofi
}

genfstabing_sys() {
    echo "[INFO]: Running genfstab command..."
    genfstab -U /mnt > /mnt/etc/fstab
}

os_release_things() {
cat > "/mnt/etc/os-release" << 'EOF'
NAME="FembArch Linux"
PRETTY_NAME="FembArch Linux"
ID=arch
BUILD_ID=rolling
ANSI_COLOR="38;2;23;147;209"
HOME_URL="https://archlinux.org/"
DOCUMENTATION_URL="https://wiki.archlinux.org/"
SUPPORT_URL="https://bbs.archlinux.org/"
BUG_REPORT_URL="https://gitlab.archlinux.org/groups/archlinux/-/issues"
PRIVACY_POLICY_URL="https://terms.archlinux.org/docs/privacy-policy/"
EOF
}

copying_and_arch_chrooting() {

cp /usr/local/bin/fembinstall-files/nvidia-drivers/nvidia-config.sh /mnt/usr/local/bin/nvidia-config
chmod +x /mnt/usr/local/bin/nvidia-config

cp /usr/local/bin/fembinstall-files/hyprland/config.sh /mnt/usr/local/bin/hyprland-config
chmod +x /mnt/usr/local/bin/hyprland-config

cat > "/mnt/usr/local/bin/fembinstall-chroot-file" << 'EOF'
#!/usr/bin/env bash

set -e

clear
echo "Chroot environment setup starting..."
sleep 2

nvidia-config
hyprland-config

echo "Set root password:"
passwd root

read -p "Username: " user
useradd -m -G wheel -s /bin/bash "$user"
passwd "$user"

read -p "Hostname (default: fembarch-linux): " hostname
hostname=${hostname:-fembarch-linux}

echo "$hostname" > /etc/hostname

echo "Enable femboy command? (y/n)"
read -p ":> " choice

if [[ "$choice" == "y" ]]; then
cat > /usr/local/bin/be << 'EOC'
#!/usr/bin/env bash
if [[ "$1" == "femboy" ]]; then
    echo "you are now 100% valid :3"
fi
EOC
chmod +x /usr/local/bin/be
fi

mkdir -p /boot/efi

grub-install \
  --target=x86_64-efi \
  --efi-directory=/boot/efi \
  --bootloader-id=FEMBARCH

grub-mkconfig -o /boot/grub/grub.cfg

echo "Rebooting in 3 seconds..."
sleep 3
reboot
EOF

chmod +x /mnt/usr/local/bin/fembinstall-chroot-file

echo "[INFO]: Entering chroot. Run fembinstall-chroot-file after entering."
sleep 2

arch-chroot /mnt
}


# Call functions
partitioning_mounting
pacstrapping_sys
genfstabing_sys
os_release_things
copying_and_arch_chrooting
