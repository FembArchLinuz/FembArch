#!/usr/bin/env bash

set -e

echo ""
echo "
 _____              _       _             _       _     _
|  ___|__ _ __ ___ | |__   / \   _ __ ___| |__   | |   (_)_ __  _   ___  __
| |_ / _ \ '_ ` _ \| '_ \ / _ \ | '__/ __| '_ \  | |   | | '_ \| | | \ \/ /
|  _|  __/ | | | | | |_) / ___ \| | | (__| | | | | |___| | | | | |_| |>  <
|_|  \___|_| |_| |_|_.__/_/   \_\_|  \___|_| |_| |_____|_|_| |_|\__,_/_/\_\ Live ISO
"
sleep 5

partitioning_mounting() {
umount -R /mnt 2>/dev/null || true

read -p "Select disk (e.g. /dev/sda or /dev/nvme0n1): " DISK

parted -s "$DISK" mklabel gpt
parted -s "$DISK" mkpart ESP fat32 1MiB 513MiB
parted -s "$DISK" set 1 esp on
parted -s "$DISK" mkpart root ext4 513MiB 100%

udevadm settle
partprobe "$DISK"
sleep 2

BOOT_PART=$(lsblk -lnpo NAME "$DISK" | sed -n '2p')
ROOT_PART=$(lsblk -lnpo NAME "$DISK" | sed -n '3p')

mkfs.fat -F32 "$BOOT_PART"
mkfs.ext4 -F "$ROOT_PART"

mount "$ROOT_PART" /mnt
mkdir -p /mnt/boot/efi
mount "$BOOT_PART" /mnt/boot/efi
}


pacstrapping_sys() {
    echo "-- Pacstrap --"
    echo "[INFO]: Pacstrapping system...."
    pacstrap /mnt base base-devel linux linux-firmware linux-headers arch-install-scripts grub efibootmgr networkmanager nano vim fastfetch hyprland xdg-desktop-portal-hyprland sddm kitty waybar wofi git sudo
}

genfstabing_sys() {
    echo "-- Genfstab --"
    echo "[INFO]: Running genfstab command..."
    genfstab -U /mnt >> /mnt/etc/fstab
}

os_release_things() {
cat > "/mnt/etc/os-release" << 'EOF'
NAME="FembArch Linux"
PRETTY_NAME="FembArch Linux"
ID=arch
BUILD_ID=rolling
ANSI_COLOR="38;2;23;147;209"
HOME_URL="https://archlinux.org/"
DOCUMENTATION_URL="https://wiki.archlinux.org/"
SUPPORT_URL="https://bbs.archlinux.org/"
BUG_REPORT_URL="https://gitlab.archlinux.org/groups/archlinux/-/issues"
PRIVACY_POLICY_URL="https://terms.archlinux.org/docs/privacy-policy/"
EOF
}

copying_and_arch_chrooting() {

# Create directory if it doesn't exist before copying :D
if [[ ! -d /mnt/usr/local/bin/ ]]; then
    mkdir -p /mnt/usr/local/bin/
fi

# Use -f to be sure that cp works when copying :0
cp -f /usr/local/bin/fembinstall-files/nvidia-drivers/nvidia-config.sh /mnt/usr/local/bin/nvidia-config || true
chmod +x /mnt/usr/local/bin/nvidia-config || true

cp -f /usr/local/bin/fembinstall-files/hyprland/config.sh /mnt/usr/local/bin/hyprland-config || true
chmod +x /mnt/usr/local/bin/hyprland-config || true

arch-chroot /mnt bash << 'EOF'
#!/usr/bin/env bash
set -e

# Run configs if they exist (AND ONLY IF THEY EXIST)
[[ -f /usr/local/bin/nvidia-config ]] && /usr/local/bin/nvidia-config
[[ -f /usr/local/bin/hyprland-config ]] && /usr/local/bin/hyprland-config

echo "Set root password:"
passwd root

read -p "Username: " user
useradd -m -G wheel -s /bin/bash "$user"
passwd "$user"

# Give wheel group sudo access
echo "%wheel ALL=(ALL:ALL) NOPASSWD: ALL" > /etc/sudoers.d/10-fembarch

# Fastfetch config
echo "-- Fastfetch Config --"
echo "[INFO]: We have our own fastfetch config and we are gonna apply it, if you don't want it do after installation:"
echo "'rm -rf $HOME/.config/fastfetch/config.jsonc' and 'fastfetch --gen-config-full' or 'fastfetch --gen-config'."
if [[ ! -d /home/$user/.config/fastfetch/ ]]; then
    mkdir -p /home/"$user"/.config/fastfetch/
fi
sleep 3
[[ ! -f /home/$user/.config/fastfetch/config.jsonc ]] && cat > /home/$user/.config/fastfetch/config.jsonc << 'EOF'

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch_small",
        "padding": {
            "top": 1
        }
    },
    "display": {
        "separator": " 󰄾 ",
        "color": {
            "keys": "magenta",
            "title": "magenta"
        }
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "󰣇 Distro",
            "keyColor": "magenta"
        },
        {
            "type": "kernel",
            "key": "󰌢 Kernel",
            "keyColor": "magenta"
        },
        {
            "type": "shell",
            "key": " Shell",
            "keyColor": "magenta"
        },
        "break",
        "colors"
    ]
}
EOF

# Install yay as the created user (makepkg cannot run as root, and that's true btw)
echo "-- Yay (AUR) --"
echo "[INFO]: Installing yay as $user..."
sudo -u "$user" bash << 'EOC'
cd /home/$user
git clone https://aur.archlinux.org/yay.git
cd yay
makepkg -si --noconfirm
cd ..
rm -rf yay
EOC

echo "-- Hostname --"

read -p "Hostname (default: fembarch-linux): " hostname
hostname=${hostname:-fembarch-linux}
echo "$hostname" > /etc/hostname

echo "-- Bootloader --"

grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=FEMBARCH
grub-mkconfig -o /boot/grub/grub.cfg

systemctl enable NetworkManager
systemctl enable sddm

echo "Setup complete. Exiting..."
echo "Umount /mnt and reboot bye <3"
sleep 1
exit 0
}

# Call functions
partitioning_mounting
pacstrapping_sys
genfstabing_sys
os_release_things
copying_and_arch_chrooting
