#!/usr/bin/env bash

set -e

cat << 'EOF'
 _____              _       _             _       _     _
|  ___|__ _ __ ___ | |__   / \   _ __ ___| |__   | |   (_)_ __  _   ___  __
| |_ / _ \ '_ ` _ \| '_ \ / _ \ | '__/ __| '_ \  | |   | | '_ \| | | \ \/ /
|  _|  __/ | | | | | |_) / ___ \| | | (__| | | | | |___| | | | | |_| |>  <
|_|  \___|_| |_| |_|_.__/_/   \_\_|  \___|_| |_| |_____|_|_| |_|\__,_/_/\_\ Installer
EOF

sleep 0.5

read -p "Select disk (e.g. /dev/nvme0n1): " DISK
read -p "New User (include username.): " user
read -p "User Password: " user_passwd
read -p "Hostname (default: fembarch-linux): " HOSTNAME
HOSTNAME=${HOSTNAME:-fembarch-linux}

partitioning_mounting() {
    umount -R /mnt 2>/dev/null || true
    parted -s "$DISK" mklabel gpt
    parted -s "$DISK" mkpart ESP fat32 1MiB 513MiB
    parted -s "$DISK" set 1 esp on
    parted -s "$DISK" mkpart root ext4 513MiB 100%
    udevadm settle
    BOOT_PART=$(lsblk -lnpo NAME "$DISK" | sed -n '2p')
    ROOT_PART=$(lsblk -lnpo NAME "$DISK" | sed -n '3p')
    mkfs.fat -F32 "$BOOT_PART"
    mkfs.ext4 -F "$ROOT_PART"
    mount "$ROOT_PART" /mnt
    mkdir -p /mnt/boot/efi
    mount "$BOOT_PART" /mnt/boot/efi
}

pacstrapping_sys() {
    pacstrap /mnt base base-devel linux linux-firmware linux-headers arch-install-scripts grub efibootmgr networkmanager nano vim fastfetch hyprland xdg-desktop-portal-hyprland sddm kitty waybar wofi git sudo
}

genfstabing_sys() {
    genfstab -U /mnt >> /mnt/etc/fstab
}

os_release_things() {
cat > "/mnt/etc/os-release" << 'EOF'
NAME="FembArch Linux"
PRETTY_NAME="FembArch Linux"
ID=arch
BUILD_ID=rolling
ANSI_COLOR="38;2;23;147;209"
HOME_URL="https://archlinux.org/"
DOCUMENTATION_URL="https://wiki.archlinux.org/"
SUPPORT_URL="https://bbs.archlinux.org/"
BUG_REPORT_URL="https://gitlab.archlinux.org/groups/archlinux/-/issues"
PRIVACY_POLICY_URL="https://terms.archlinux.org/docs/privacy-policy/"
EOF
}

copying_and_arch_chrooting() {
    mkdir -p /mnt/usr/local/bin/
    cp -f /usr/local/bin/fembinstall-files/nvidia-drivers/nvidia-config.sh /mnt/usr/local/bin/nvidia-config || true
    cp -f /usr/local/bin/fembinstall-files/hyprland/config.sh /mnt/usr/local/bin/hyprland-config || true
    chmod +x /mnt/usr/local/bin/nvidia-config /mnt/usr/local/bin/hyprland-config || true

    arch-chroot /mnt /bin/bash <<EOF
    set -e

    [[ -f /usr/local/bin/nvidia-config ]] && /usr/local/bin/nvidia-config
    [[ -f /usr/local/bin/hyprland-config ]] && /usr/local/bin/hyprland-config

    useradd -m -G wheel -s /bin/bash "$user"
    echo "$user:$user_passwd" | chpasswd
    echo "%wheel ALL=(ALL:ALL) NOPASSWD: ALL" > /etc/sudoers.d/10-fembarch

    echo "$HOSTNAME" > /etc/hostname

    mkdir -p /home/$user/.config/fastfetch/
    cat > /home/$user/.config/fastfetch/config.jsonc <<'EOC'
{
    "\$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch_small",
        "padding": { "top": 1 }
    },
    "display": {
        "separator": " 󰄾 ",
        "color": { "keys": "magenta", "title": "magenta" }
    },
    "modules": [
        "title",
        "separator",
        { "type": "os", "key": "󰣇 Distro", "keyColor": "magenta" },
        { "type": "kernel", "key": "󰌢 Kernel", "keyColor": "magenta" },
        { "type": "shell", "key": " Shell", "keyColor": "magenta" },
        "break",
        "colors"
    ]
}
EOC
    chown -R $user:$user /home/$user/.config

    sudo -u $user bash -c "cd /home/$user && git clone https://aur.archlinux.org/yay.git && cd yay && makepkg -si --noconfirm && cd .. && rm -rf yay"

    grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=FEMBARCH
    grub-mkconfig -o /boot/grub/grub.cfg
    systemctl enable NetworkManager sddm
    echo "Last check mate..."
    mkinitcpio -P
    exit 0
EOF
}

partitioning_mounting
pacstrapping_sys
genfstabing_sys
os_release_things
copying_and_arch_chrooting

echo "Installed FembArch Linux VER: 1.3.0"
sleep 1
echo "Umounting filesystem and rebooting..."
umount -R /mnt
reboot
