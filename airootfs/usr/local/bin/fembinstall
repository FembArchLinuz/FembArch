#!/usr/bin/env python3

import os
import sys
import subprocess
import time
import curses

os.system("clear")

def main():
    subprocess.run(["bash", "/usr/local/bin/fembinstall-files/installer/fembinstall-installer"])
  
if os.geteuid() != 0:
    print("!!! You need to run fembinstall as root (sudo fembinstall)!")
    sys.exit(1)

def select_menu(stdscr):

    curses.curs_set(0)
    curses.init_pair(1, curses.COLOR_CYAN, curses.COLOR_BLACK)
    
    options = ["Automated Install", "Manual Install", "Exit"]
    current_row = 0

    while True:
        stdscr.addstr("--- FembArch Installer ---\n", curses.color_pair(1) | curses.A_BOLD)
        stdscr.addstr("[INFO]: Use arrows to select and Enter to confirm.\n\n")

        for i, option in enumerate(options):
            if i == current_row:
                # Highlight the selection
                stdscr.addstr(f"  > {option} <\n", curses.A_REVERSE)
            else:
                stdscr.addstr(f"    {option}\n")

        key = stdscr.getch()

        if key == curses.KEY_UP and current_row > 0:
            current_row -= 1
        elif key == curses.KEY_DOWN and current_row < len(options) - 1:
            current_row += 1
        elif key in [curses.KEY_ENTER, 10, 13]:
            return options[current_row]

choice = curses.wrapper(select_menu)

if choice == "Manual Install":
    print("Js go and read the wiki kys :3")
    sys.exit(0)
elif choice == "Automated Install"
    main()
