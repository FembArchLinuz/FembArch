#!/usr/bin/env python3

import os
import sys
import subprocess
import time

os.system("clear")

def main():
    subprocess.run(["/usr/local/bin/fembinstall-fules/wifi-connection/wifi.sh"])
    time.sleep(1)
    subprocess.run(["/usr/local/bin/fembinstall-files/installer/fembinstall-helper"])

if os.geteuid() != 0:
    print("!!! You need to run fembinstall as root (sudo fembinstall)!")
    sys.exit(1)

print("--------------------------------------------------------------------------------------------------------------------------------------------------------------")
print("Welcome to fembinstall, here you can install FembArch easily or the manual way.")
print("It mainly uses bash as base to pacstrap and things for like fembinstall-ez. Note that fembarch won't currently make the localtime or the partitioning for you!")
print("--------------------------------------------------------------------------------------------------------------------------------------------------------------")
print("Type ez to install fembarch easily. Type manual to manual install fembarch linux")
choice = input(":> ")

if choice == "ez":
    main()
elif choice == "manual":
    print("Go and read the wiki.")
